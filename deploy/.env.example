# Скопіюйте у .env на сервері й підставте власні значення.
# Файл .env у репозиторій не потрапляє.

DOMAIN=slipstream.duckdns.org
# Попереднє ім'я: лишається робочим і перенаправляє на основне.
# Має відрізнятися від DOMAIN, інакше Caddy не запуститься.
DOMAIN_LEGACY=slipstream-demo-plc.polandcentral.cloudapp.azure.com

POSTGRES_USER=cicd
POSTGRES_DB=cicd
# openssl rand -base64 24
POSTGRES_PASSWORD=

# openssl rand -hex 32
SECRET_KEY=

# Поріг, з якого система починає скорочувати набір перевірок.
MIN_PIPELINES_TO_OPTIMIZE=60

# --- захист входу від перебору пароля (значення за замовчуванням у коді) ---
# Скільком ОСТАННІМ елементам X-Forwarded-For довіряти, тобто скільки
# власних проксі стоїть перед застосунком. У складі служб їх один — caddy.
TRUSTED_PROXIES=1
# Невдалих спроб з однієї адреси до блокування
LOGIN_MAX_FAILURES=8
# Невдалих спроб на один обліковий запис (поріг вищий: заблокувати чужий
# запис навмисне не повинно бути дешево)
LOGIN_ACCOUNT_MAX_FAILURES=20
# Вікно обліку й тривалість блокування, секунди
LOGIN_WINDOW_S=900
LOGIN_LOCKOUT_S=900

# --- резервне копіювання (slipstream-backup.timer) ---
BACKUP_DIR=/var/backups/slipstream
BACKUP_KEEP=7
